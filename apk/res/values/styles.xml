<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/ritm_bg</item>
        <item name="colorPrimaryDark">@color/ritm_bg</item>
        <item name="colorAccent">@color/ritm_accent</item>
    </style>

    <!-- Основная тема: системные панели в цвет фона приложения, светлые или тёмные значки по теме телефона -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/ritm_bg</item>
        <item name="android:statusBarColor">@color/ritm_bg</item>
        <item name="android:navigationBarColor">@color/ritm_bg</item>
        <item name="android:windowLightStatusBar">@bool/ritm_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ritm_light_bars</item>
    </style>

    <!-- Заставка при запуске -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ritm_bg</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
